# Copy this file to .env and fill in your keys

# Required for the LangGraph agent (layout planning, copywriting, QA)
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model to use. A stronger model (e.g. gemini-2.5-pro) generally
# produces better layouts/copy than a flash variant. Set to whatever your
# provider/key supports.
GEMINI_MODEL=gemini-3.6-flash

# Optional — enables real AI image generation for backgrounds/graphics.
# Highest quality (Flux via Replicate). Without it, the app uses Pollinations.ai
# (free, key-less Flux-backed image generation) by default, and only falls back
# to offline generated placeholders if that is unreachable.
REPLICATE_API_TOKEN=

# Set to "false" to disable Pollinations and only use placeholders when no
# Replicate token is configured.
USE_POLLINATIONS=true

# Database (SQLite by default — zero setup. Swap for Postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./design_studio.db

# Where generated/uploaded assets are written. Local disk by default.
ASSET_STORAGE_DIR=./storage

# CORS — the Vite dev server origin
FRONTEND_ORIGIN=http://localhost:5173
